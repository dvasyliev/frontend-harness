{
  "$comment": "Every framework and module the harness can install. A module's files are in files/<module>/: all/ for every framework, <framework>/ for one; each is written at the same path in the project and merged with the project's edits. A module also brings: `scripts` (package.json), `checks` and `fileChecks` (what the hooks run, read from .claude/harness.json), `settings` (merged into .claude/settings.json), `install` (commands, each run when one of the paths it `creates` is missing; with none, every time), `mcp` (the .mcp.json servers its install adds), npm `devDependencies` and `frameworkDevDependencies`. `required` modules are always installed, `auto` ones exactly when their `detect` matches package.json, and exactly one `linter` module is. The frontend-harness skill suggests modules by `detect` and `recommended`.",
  "frameworks": {
    "nextjs": {
      "description": "Next.js App Router",
      "port": 3000,
      "srcDirs": ["app", "lib"],
      "detect": {
        "dependencies": ["next"]
      },
      "linter": "eslint"
    },
    "react": {
      "description": "React (Vite)",
      "port": 5173,
      "srcDirs": ["src"],
      "detect": {
        "dependencies": ["react"]
      },
      "linter": "oxlint"
    }
  },
  "modules": {
    "core": {
      "description": "Claude Code hooks, the structure and hooks rules, typecheck and Prettier on every edit and turn.",
      "required": true,
      "scripts": {
        "typecheck": {
          "command": "tsc -b",
          "description": "TypeScript; never `tsc --noEmit`"
        },
        "format": {
          "command": "prettier --write .",
          "description": "Prettier, whole repo"
        },
        "format:check": {
          "command": "prettier --check .",
          "description": "Prettier check only"
        },
        "format:file": {
          "command": "prettier --write",
          "description": "Prettier on one file (used by the edit hook)"
        },
        "check": {
          "command": ".claude/hooks/check-all.sh --force",
          "description": "all checks at once, as the Stop hook runs them"
        }
      },
      "checks": [
        {
          "name": "types",
          "script": "typecheck"
        },
        {
          "name": "format",
          "script": "format:check"
        }
      ],
      "fileChecks": [
        {
          "name": "format",
          "script": "format:file",
          "extensions": [
            "ts",
            "tsx",
            "mts",
            "js",
            "jsx",
            "mjs",
            "css",
            "json",
            "md"
          ],
          "blocking": false
        }
      ],
      "devDependencies": ["typescript", "prettier"],
      "settings": {
        "hooks": {
          "SessionStart": [
            {
              "matcher": "startup|resume|clear",
              "hooks": [
                {
                  "type": "command",
                  "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
                }
              ]
            }
          ],
          "PreToolUse": [
            {
              "matcher": "Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.sh\"",
                  "statusMessage": "Checking command"
                }
              ]
            }
          ],
          "PostToolUse": [
            {
              "matcher": "Edit|Write",
              "hooks": [
                {
                  "type": "command",
                  "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-lint-file.sh\"",
                  "timeout": 60,
                  "statusMessage": "Formatting and linting"
                }
              ]
            }
          ],
          "Stop": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-all.sh\"",
                  "timeout": 600,
                  "statusMessage": "Running checks"
                }
              ]
            }
          ]
        },
        "permissions": {
          "deny": ["Read(./.env)", "Read(./.env.*)"]
        }
      }
    },
    "feature-workflow": {
      "description": "The feature-workflow skill (spec, plan, tests first, browser check, end-to-end tests, improve the harness), the rule for how agents work here (on main, several at once), the superpowers plugin and the improve-harness skill.",
      "recommended": true,
      "settings": {
        "enabledPlugins": {
          "superpowers@claude-plugins-official": true
        }
      },
      "install": [
        {
          "command": "claude plugin install superpowers@claude-plugins-official --scope project"
        }
      ]
    },
    "eslint": {
      "description": "ESLint with type-aware typescript-eslint rules, a 400-line file limit and (on Next) the folder rules from structure.md. Needs TypeScript below 6.1.",
      "detect": {
        "devDependencies": ["eslint"]
      },
      "linter": true,
      "scripts": {
        "lint": {
          "command": "eslint --max-warnings 0",
          "description": "ESLint, no warnings allowed"
        },
        "lint:file": {
          "command": "eslint --max-warnings 0",
          "description": "ESLint on one file (used by the edit hook)"
        }
      },
      "checks": [
        {
          "name": "lint",
          "script": "lint"
        }
      ],
      "fileChecks": [
        {
          "name": "lint",
          "script": "lint:file",
          "extensions": ["ts", "tsx", "mts", "js", "jsx", "mjs"],
          "blocking": true
        }
      ],
      "devDependencies": [
        "eslint",
        "eslint-config-prettier",
        "typescript-eslint"
      ],
      "frameworkDevDependencies": {
        "nextjs": ["eslint-config-next", "eslint-plugin-boundaries"],
        "react": [
          "@eslint/js",
          "globals",
          "eslint-plugin-react-hooks",
          "eslint-plugin-react-refresh"
        ]
      }
    },
    "oxlint": {
      "description": "oxlint (what create-vite sets up; works with TypeScript 7) with a 400-line file limit.",
      "detect": {
        "devDependencies": ["oxlint"]
      },
      "linter": true,
      "scripts": {
        "lint": {
          "command": "oxlint --deny-warnings",
          "description": "oxlint, no warnings allowed"
        },
        "lint:file": {
          "command": "oxlint --deny-warnings",
          "description": "oxlint on one file (used by the edit hook)"
        }
      },
      "checks": [
        {
          "name": "lint",
          "script": "lint"
        }
      ],
      "fileChecks": [
        {
          "name": "lint",
          "script": "lint:file",
          "extensions": ["ts", "tsx", "mts", "js", "jsx", "mjs"],
          "blocking": true
        }
      ],
      "devDependencies": ["oxlint"]
    },
    "unit": {
      "description": "Vitest unit tests, run at the end of every turn.",
      "recommended": true,
      "detect": {
        "devDependencies": ["vitest"]
      },
      "scripts": {
        "test": {
          "command": "vitest run --passWithNoTests",
          "description": "all unit tests (Vitest); `npx vitest run <file>` for one"
        }
      },
      "checks": [
        {
          "name": "test",
          "script": "test"
        }
      ],
      "devDependencies": [
        "vitest",
        "jsdom",
        "@vitejs/plugin-react",
        "@testing-library/react",
        "@testing-library/dom"
      ]
    },
    "e2e": {
      "description": "Playwright end-to-end tests, the playwright-cli skill for browser checks, and a pre-push hook that runs them.",
      "recommended": true,
      "detect": {
        "devDependencies": ["@playwright/test"]
      },
      "scripts": {
        "verify": {
          "command": "playwright test",
          "description": "all end-to-end tests; `npx playwright test <file>` for one"
        },
        "prepare": {
          "command": "git config core.hooksPath .githooks",
          "description": "turns on the git hooks in .githooks/ (npm runs it on install)"
        }
      },
      "devDependencies": ["@playwright/test", "@playwright/cli"],
      "install": [
        {
          "command": "npx -y skills add microsoft/playwright-cli --skill playwright-cli -a claude-code --copy -y",
          "creates": [".claude/skills/playwright-cli"]
        }
      ]
    },
    "commitlint": {
      "description": "Conventional Commits checked by commitlint in a commit-msg hook, plus the skill that writes valid messages.",
      "recommended": true,
      "scripts": {
        "prepare": {
          "command": "git config core.hooksPath .githooks",
          "description": "turns on the git hooks in .githooks/ (npm runs it on install)"
        }
      },
      "devDependencies": ["@commitlint/cli", "@commitlint/config-conventional"],
      "install": [
        {
          "command": "mkdir -p .claude/skills/committing-with-commitlint && curl -fLo .claude/skills/committing-with-commitlint/SKILL.md https://raw.githubusercontent.com/conventional-changelog/commitlint/master/skills/committing-with-commitlint/SKILL.md",
          "creates": [".claude/skills/committing-with-commitlint"]
        }
      ]
    },
    "quality": {
      "description": "knip (unused files, exports, dependencies) and jscpd (duplicated code), run at the end of every turn.",
      "recommended": true,
      "scripts": {
        "knip": {
          "command": "knip --no-progress --reporter compact",
          "description": "unused files, exports and dependencies"
        },
        "dupes": {
          "command": "jscpd {srcDirs} --threshold 0 --reporters console",
          "description": "duplicated code (jscpd)"
        }
      },
      "checks": [
        {
          "name": "knip",
          "script": "knip"
        },
        {
          "name": "dupes",
          "script": "dupes"
        }
      ],
      "devDependencies": ["knip", "jscpd"]
    },
    "best-practices": {
      "description": "Vercel's React performance, composition and Web Interface Guidelines skills, and the rules for fast pages and lists (with how to measure them) for the framework.",
      "recommended": true,
      "install": [
        {
          "command": "npx -y skills add vercel-labs/agent-skills --skill vercel-react-best-practices -a claude-code --copy -y",
          "creates": [".claude/skills/vercel-react-best-practices"]
        },
        {
          "command": "npx -y skills add vercel-labs/agent-skills --skill vercel-composition-patterns -a claude-code --copy -y",
          "creates": [".claude/skills/vercel-composition-patterns"]
        },
        {
          "command": "npx -y skills add vercel-labs/agent-skills --skill web-design-guidelines -a claude-code --copy -y",
          "creates": [".claude/skills/web-design-guidelines"]
        }
      ]
    },
    "context7": {
      "description": "Context7 MCP server, rule and skill for current library docs.",
      "recommended": true,
      "mcp": ["context7"],
      "install": [
        {
          "command": "npx -y ctx7 setup --claude --project --oauth --mcp -y",
          "creates": [
            ".claude/rules/context7.md",
            ".claude/skills/context7-mcp"
          ]
        }
      ]
    },
    "tailwind": {
      "description": "Prettier plugin that sorts Tailwind classes, with its .prettierrc.json.",
      "auto": true,
      "detect": {
        "dependencies": ["tailwindcss"],
        "devDependencies": ["tailwindcss"]
      },
      "devDependencies": ["prettier-plugin-tailwindcss"]
    }
  }
}
