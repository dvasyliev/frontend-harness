#!/usr/bin/env sh
# Way out for a human: SKIP_VERIFY=1 git push skips the check
[ -n "$SKIP_VERIFY" ] && { echo "pre-push: skipped via SKIP_VERIFY" >&2; exit 0; }

# The refs being pushed, one "<local ref> <local sha> <remote ref> <remote sha>"
# per line; kept for pre-push.local, which reads them too.
refs=$(cat)

# Skip the tests when every commit pushed holds exactly the code that last
# passed the whole suite (.githooks/verify.sh keeps it in .git/e2e-green).
green=$(cat "$(git rev-parse --git-dir)/e2e-green" 2>/dev/null)
same=false
if [ -n "$green" ] && [ -n "$refs" ]; then
	same=true
	while read -r _ sha _ _; do
		# A deleted branch pushes no code.
		[ "$sha" = 0000000000000000000000000000000000000000 ] && continue
		[ "$(git rev-parse "$sha^{tree}" 2>/dev/null)" = "$green" ] || same=false
	done <<EOF
$refs
EOF
fi

if $same; then
	echo "pre-push: this code already passed npm run verify; skipping it"
else
	# Run the end-to-end tests. If they fail, the push is cancelled.
	# On macOS caffeinate keeps the Mac awake: a Mac that sleeps fails random tests.
	echo "pre-push: running npm run verify"
	if command -v caffeinate >/dev/null 2>&1; then
		caffeinate -dims npm run -s verify || exit 1
	else
		npm run -s verify || exit 1
	fi
fi

# The project's own pre-push steps, which the harness never writes or overwrites.
# It gets the same arguments, and the refs being pushed on stdin.
if [ -x .githooks/pre-push.local ]; then
	printf '%s\n' "$refs" | .githooks/pre-push.local "$@" || exit 1
fi
exit 0
